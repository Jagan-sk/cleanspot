# Backend config (copy to .env and adjust)
ENV=development
DATABASE_URL=sqlite:///./cleanspot.db
UPLOAD_DIR=./uploads

# --- security (READ THE README "Security" SECTION) -------------------------
# Secret used to sign login tokens. Generate your own:
#   openssl rand -hex 32
# The app refuses to start without it unless DEBUG=1 (dev only!).
SECRET_KEY=
DEBUG=1
# signed login tokens expire after this many hours
TOKEN_EXPIRE_HOURS=12
# Passwords of the seeded demo accounts - CHANGE THESE BEFORE ANY REAL USE
SEED_CITIZEN_PASSWORD=citizen-demo-123
SEED_OFFICER_PASSWORD=officer-demo-123
SEED_ADMIN_PASSWORD=admin-demo-123
# the per-zone demo officers (officer_zone1..4 share one password)
SEED_ZONE_OFFICER_PASSWORD=zone-officer-demo-123

# --- uploads ----------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=8
# images larger than this on either side are downscaled; EXIF (incl. GPS) is stripped
MAX_IMAGE_DIMENSION=4096
# comma-separated list
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.webp

# --- AI ---------------------------------------------------------------------
AI_CONFIDENCE_THRESHOLD=0.7
# trained model file (relative to the backend folder)
MODEL_PATH=models/garbage_classifier.pt
# AI decision thresholds:
#   confidence >= AUTO_ACCEPT                -> accepted (shown as "Photo checked")
#   REVIEW_BELOW <= confidence < AUTO_ACCEPT -> needs_review
#   confidence < REVIEW_BELOW                -> needs_review_low_confidence
AUTO_ACCEPT=0.80
REVIEW_BELOW=0.50

# --- misc -------------------------------------------------------------------
MUNICIPAL_BASE_URL=http://localhost:8000/municipal
REPORT_RATE_LIMIT_PER_HOUR=10
# comma-separated allowed origins; use * only if you do not need credentials
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
